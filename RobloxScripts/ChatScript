-- finds reviews

local rep = game:GetService("ReplicatedStorage")
local Find = rep:WaitForChild("FindReview")
local HttpService = game:GetService("HttpService")

local function Finding(player)
	local url = "http://YourServer:3000/findreviews" -- URL to the server
	local response
	local data
	pcall(function()
		-- sending a POST request with parameters
		response = HttpService:PostAsync(url, HttpService:JSONEncode({
			name = tostring(player)
		}))
		data = HttpService:JSONDecode(response)
	end)
	return data.result
end

Find.OnServerInvoke = Finding
